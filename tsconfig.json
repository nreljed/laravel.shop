{
    "compilerOptions": {
        "allowJs": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noUncheckedIndexedAccess": true,
        "isolatedModules": true,
        "target": "ESNext",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": false,
        "skipLibCheck": true,
        "noEmit": true,
        "typeRoots": [
            "./node_modules/@types"
        ],
        "paths": {
            "@dashboard/*": ["./vendor/nreljed/platform/resources/js/*"],
            "@blog": ["./vendor/nreljed/blog/src/Resources/js"],
            "@blog/*": ["./vendor/nreljed/blog/src/Resources/js/*"],
            "@dashboard-themes": ["./vendor/nreljed/platform/resources/themes"],
            "@dashboard-themes/*": ["./vendor/nreljed/platform/resources/themes/*"],
            "@/*": ["./vendor/nreljed/platform/resources/js/*"],
            "@shop": ["./vendor/nreljed/shop-module/src/Resources/js"],
            "@shop/*": ["./vendor/nreljed/shop-module/src/Resources/js/*"],
            "ziggy-js": ["./vendor/tightenco/ziggy"],
            "@inertiajs/core": ["./node_modules/@inertiajs/core"],
            "@inertiajs/react": ["./node_modules/@inertiajs/react"],
            "@inertiajs/vite": ["./node_modules/@inertiajs/vite"],
            "react": ["./node_modules/@types/react/index.d.ts"],
            "react/*": ["./node_modules/@types/react/*"],
            "react-dom": ["./node_modules/@types/react-dom/index.d.ts"],
            "react-dom/*": ["./node_modules/@types/react-dom/*"]
        }
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.tsx",
        "resources/js/**/*.d.ts",
        "vendor/nreljed/platform/resources/js/**/*.ts",
        "vendor/nreljed/platform/resources/js/**/*.tsx",
        "vendor/nreljed/platform/resources/js/**/*.d.ts",
        "vendor/nreljed/platform/resources/themes/**/*.ts",
        "vendor/nreljed/platform/resources/themes/**/*.tsx",
        "vendor/nreljed/platform/resources/themes/**/*.d.ts",
        "vendor/nreljed/platform/src/**/Resources/js/**/*.ts",
        "vendor/nreljed/platform/src/**/Resources/js/**/*.tsx",
        "vendor/nreljed/platform/src/**/Resources/js/**/*.d.ts",
        "vendor/nreljed/blog/src/Resources/js/**/*.ts",
        "vendor/nreljed/blog/src/Resources/js/**/*.tsx",
        "vendor/nreljed/blog/src/Resources/js/**/*.d.ts"
    ]
}