{
    "compilerOptions": {
        "allowJs": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noUncheckedIndexedAccess": true,
        "isolatedModules": true,
        "target": "ESNext",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": false,
        "skipLibCheck": true,
        "noEmit": true,
        "typeRoots": [
            "./node_modules/@types"
        ],
        "paths": {
            "@dashboard/*": ["./packages/dashboard-core/resources/js/*"],
            "@dashboard-blog/*": ["./packages/dashboard-core/src/Blog/Resources/js/*"],
            "@/*": ["./packages/dashboard-core/resources/js/*"],
            "@shop": ["./app/Shop/Resources/js"],
            "@shop/*": ["./app/Shop/Resources/js/*"],
            "ziggy-js": ["./vendor/tightenco/ziggy"],
            "@inertiajs/core": ["./node_modules/@inertiajs/core"],
            "@inertiajs/react": ["./node_modules/@inertiajs/react"],
            "@inertiajs/vite": ["./node_modules/@inertiajs/vite"],
            "react": ["./node_modules/@types/react/index.d.ts"],
            "react/*": ["./node_modules/@types/react/*"],
            "react-dom": ["./node_modules/@types/react-dom/index.d.ts"],
            "react-dom/*": ["./node_modules/@types/react-dom/*"]
        }
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.tsx",
        "resources/js/**/*.d.ts",
        "packages/dashboard-core/resources/js/**/*.ts",
        "packages/dashboard-core/resources/js/**/*.tsx",
        "packages/dashboard-core/resources/js/**/*.d.ts",
        "packages/dashboard-core/src/**/Resources/js/**/*.ts",
        "packages/dashboard-core/src/**/Resources/js/**/*.tsx",
        "packages/dashboard-core/src/**/Resources/js/**/*.d.ts"
    ]
}
